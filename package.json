{
  "name": "@cr34tics/exceljs",
  "version": "5.1.0",
  "description": "Excel Workbook Manager - Read and Write xlsx and csv Files.",
  "license": "MIT",
  "author": {
    "name": "Guyon Roche",
    "email": "guyon@live.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cr34tics/exceljs.git"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./excel.js",
  "browser": "./dist/exceljs.min.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "lib",
    "excel.js",
    "LICENSE",
    "README.md",
    "README_zh.md",
    "index.ts",
    "index.d.ts"
  ],
  "scripts": {
    "test": "yarn test:full",
    "test:cjs": "cross-env EXCEL_BUILD=cjs yarn test:full",
    "test:full": "yarn build && yarn test:unit && yarn test:integration && yarn test:end-to-end && yarn test:browser",
    "test:version": "yarn build && yarn test:unit && yarn test:integration && yarn test:end-to-end && yarn test:browser && yarn test:dist",
    "test:all": "yarn test:native && yarn test:cjs",
    "test:native": "yarn test:full",
    "test:unit": "mocha --require spec/config/setup.js --require spec/config/setup-unit.js spec/unit --recursive",
    "test:integration": "mocha --require spec/config/setup.js spec/integration --recursive",
    "test:end-to-end": "mocha --require spec/config/setup.js spec/end-to-end --recursive",
    "test:browser": "yarn build && yarn test:browser:run",
    "test:browser:run": "node scripts/test-browser.js",
    "test:unit:cjs": "cross-env EXCEL_BUILD=cjs yarn test:unit",
    "test:integration:cjs": "cross-env EXCEL_BUILD=cjs yarn test:integration",
    "test:end-to-end:cjs": "cross-env EXCEL_BUILD=cjs yarn test:end-to-end",
    "test:dist": "mocha --require spec/config/setup.js spec/dist --recursive",
    "test:manual": "node spec/manual/app.js",
    "test:typescript": "mocha -r ts-node/register spec/typescript/**/*.spec.ts",
    "clean-build": "yarn clean && yarn build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "clean": "rm -rf build/ && rm -rf dist",
    "benchmark": "node --expose-gc benchmark",
    "benchmark:debug": "node --expose-gc --inspect-brk --trace-deopt benchmark",
    "build": "node scripts/build.js",
    "preversion": "yarn clean && yarn build && yarn test:version",
    "postversion": "git push --no-verify && git push --tags --no-verify",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "keywords": [
    "xlsx",
    "json",
    "csv",
    "excel",
    "font",
    "border",
    "fill",
    "number",
    "format",
    "number format",
    "alignment",
    "office",
    "spreadsheet",
    "workbook",
    "defined names",
    "data validations",
    "rich text",
    "in-cell format",
    "outlineLevel",
    "views",
    "frozen",
    "split",
    "pageSetup"
  ],
  "dependencies": {
    "archiver": "^8.0.0",
    "dayjs": "^1.8.34",
    "fast-csv": "^5.0.0",
    "fflate": "^0.8.3",
    "saxes": "^6.0.0",
    "unzipper": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@noble/hashes": "2.2.0",
    "@playwright/test": "1.61.1",
    "@types/chai": "5.2.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.13.2",
    "buffer": "6.0.3",
    "chai": "6.2.2",
    "cross-env": "10.1.0",
    "dirty-chai": "3.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-n": "18.2.1",
    "events": "3.3.0",
    "express": "5.2.1",
    "globals": "17.7.0",
    "lint-staged": "17.0.8",
    "mocha": "11.7.6",
    "prettier": "3.9.4",
    "sax": "1.6.0",
    "stream-browserify": "3.0.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "packageManager": "yarn@4.17.0"
}
