{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", "security:minimumReleaseAgeNpm"],
  "dependencyDashboard": true,
  "timezone": "Europe/Stockholm",
  "forkProcessing": "enabled",
  "schedule": ["before 6am on friday"],
  "packageRules": [
    {
      "description": "One weekly PR (Fridays) for all non-major npm & GitHub Actions updates",
      "matchManagers": ["npm", "github-actions"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "addLabels": ["dependencies"]
    },
    {
      "description": "Majors gated behind the Dependency Dashboard; grouped into one PR when approved",
      "matchManagers": ["npm", "github-actions"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "groupName": "all major dependencies",
      "groupSlug": "all-major",
      "addLabels": ["dependencies", "major"]
    },
    {
      "description": "Extra npm supply-chain age gate (mirrors Yarn's npmMinimalAgeGate: 7d)",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "7 days"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"],
    "commitMessageAction": "Lock file maintenance"
  },
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "addLabels": ["automerge"],
    "automerge": true
  }
}
